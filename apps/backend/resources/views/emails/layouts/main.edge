<!DOCTYPE html>
<html>
  <head lang="es">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <style>
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #edf3f5;
        color: #183642;
        font-family: Arial, Helvetica, sans-serif;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table {
        border-collapse: collapse;
        border-spacing: 0;
      }

      img {
        border: 0;
        display: block;
        max-width: 100%;
      }

      .email-shell {
        width: 100%;
        background-color: #edf3f5;
      }

      .email-container {
        width: 100%;
        max-width: 640px;
      }

      .brand-bar {
        background-color: #99386a;
        border-radius: 12px 12px 0 0;
      }

      .brand-mark {
        color: #9ee2ff;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 1.5px;
        line-height: 18px;
        text-transform: uppercase;
      }

      .brand-name {
        color: #ffffff;
        font-size: 25px;
        font-weight: bold;
        line-height: 32px;
      }

      .content {
        background-color: #ffffff;
        border-left: 1px solid #dce7ea;
        border-right: 1px solid #dce7ea;
        color: #314d57;
        font-size: 16px;
        line-height: 26px;
      }

      .content h1,
      .content h2,
      .content h3 {
        color: #123d4a;
        line-height: 1.25;
      }

      .content a {
        color: #d96e5b;
      }

      .footer {
        background-color: #f7fafb;
        border: 1px solid #dce7ea;
        border-radius: 0 0 12px 12px;
        color: #71878e;
        font-size: 12px;
        line-height: 19px;
      }

      .footer a {
        color: #123d4a;
        font-weight: bold;
        text-decoration: none;
      }

      @media only screen and (max-width: 640px) {
        .email-container {
          width: 100% !important;
        }

        .email-padding {
          padding-left: 22px !important;
          padding-right: 22px !important;
        }

        .brand-name {
          font-size: 22px !important;
        }

        .content {
          font-size: 15px !important;
          line-height: 24px !important;
        }
      }
    </style>
  </head>
  <body>
    <table class="email-shell" role="presentation" width="100%">
      <tr>
        <td align="center" style="padding: 28px 12px;">
          <table class="email-container" role="presentation" width="100%">
            <tr>
              <td class="brand-bar email-padding" style="padding: 30px 42px 28px;">
                <div class="brand-mark">ApartaDock</div>
                <div class="brand-name">
                  <a href="{{ appUrl }}" target="_blank" style="color: #ffffff; text-decoration: none;">
                    {{ appName }}
                  </a>
                </div>
              </td>
            </tr>
            <tr>
              <td class="content email-padding" style="padding: 34px 42px;">
                {{{ await $slots.main() }}}
              </td>
            </tr>
            <tr>
              <td class="footer email-padding" align="center" style="padding: 22px 42px;">
                <div>Este mensaje fue enviado por ApartaDock.</div>
                <div style="margin-top: 5px;">
                  &copy;
                  {{ new Date().getFullYear() }}
                  ApartaDock · Hecho con dedicación por
                  <a href="https://droni.co" target="_blank">Droni.co</a>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
