    <!-- Aquí se inyectará el contenido de cada correo individual -->
    {{{ await $slots.main() }}}

    <!-- Footer general -->
    <hr>
    <div class="footer">
      <p>
        © {{ new Date().getFullYear() }} ApartaDock. Realizado con ❤️ y mucho café por el equipo de <a href="https://droni.co" target="_blank">Droni.co</a>.
      </p>
    </div>
